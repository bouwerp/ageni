# ageni configuration. The recommended way to write this file is:
#   ageni init
# (interactive wizard; writes ~/.ageni/.env). This file is only loaded if
# present in the current working directory and overrides the global config.

# ---- Master agent (the one you talk to) ----
MASTER_PROVIDER=anthropic              # anthropic | openai | openrouter | groq |
                                       # huggingface | cerebras | mistral |
                                       # deepseek | gemini | ollama | llamacpp |
                                       # vllm | ollama-cloud | custom
MASTER_MODEL=claude-opus-4-7
# MASTER_BASE_URL=                     # only required when MASTER_PROVIDER=custom
# MASTER_API_KEY=                      # role-specific override (rare); falls
                                       # back to the provider's standard env var

# ---- Sub-agents (workers spawned by the master) ----
SUBAGENT_PROVIDER=anthropic
SUBAGENT_MODEL=claude-sonnet-4-6
# SUBAGENT_BASE_URL=
# SUBAGENT_API_KEY=

# ---- API keys (populated as defaults for any role using that provider) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=                        # only for ollama-cloud

# ---- Web search (optional) ----
# Tavily — 1k free requests/month at https://tavily.com
TAVILY_API_KEY=

# ---- Concurrency cap on sub-agents ----
# Lower this on rate-limited free tiers (Groq free = 2; HF free = 2; Cerebras = 4).
AGENI_MAX_SUBAGENTS=8
