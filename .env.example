# Master agent (the one you talk to)
MASTER_PROVIDER=anthropic              # anthropic | openai
MASTER_MODEL=claude-opus-4-7

# Sub-agents (workers spawned by the master)
SUBAGENT_PROVIDER=anthropic
SUBAGENT_MODEL=claude-sonnet-4-6

# API keys (only what's required by your providers above)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoints (set base URL only when not using openai.com)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: cap on concurrently running sub-agents
AGENI_MAX_SUBAGENTS=8
